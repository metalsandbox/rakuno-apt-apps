#!/bin/sh
set -eu
base=/usr/lib/xperia-flashtool
state="$HOME/.flashTool"
mkdir -p "$state"
if [ ! -e "$state/config.properties" ]; then
    (umask 077; printf 'gitauto=false\n' > "$state/config.properties")
fi
if [ ! -e "$state/devices" ] && [ ! -L "$state/devices" ]; then
    cp -R /usr/share/xperia-flashtool/devices "$state/devices"
fi
cd "$base"
export JAVA_HOME="$base/x10flasher_lib/linjre64"
export LD_LIBRARY_PATH="$base/x10flasher_lib/linux/lib64/udev1"
exec "$JAVA_HOME/bin/java" -Xms128m -Xmx1024m \
    -Duser.country=US -Duser.language=en \
    -Djna.library.path="$LD_LIBRARY_PATH" \
    -classpath "$base/x10flasher.jar:$base/x10flasher_lib/*:$base/x10flasher_lib/swtlin/x86_64/*" \
    gui.Main "$@"
